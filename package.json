{
  "name": "trustlens",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "locales:check": "node scripts/check-locales.mjs",
    "contrast:check": "node scripts/check-contrast.mjs",
    "verify": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm locales:check && pnpm contrast:check && pnpm test && pnpm build",
    "build:cf": "opennextjs-cloudflare build",
    "preview:cf": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy:cf": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "test:db": "node scripts/test-db.mjs",
    "seed:accounts": "node --env-file=.env.local scripts/seed-demo-accounts.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^7.0.5",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "next": "16.4.5",
    "next-intl": "^4.14.9",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "^7.91.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@formatjs/icu-messageformat-parser": "^3.5.22",
    "@opennextjs/cloudflare": "^1.20.16",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "prettier": "^3.9.10",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.1.0",
    "wrangler": "^4.158.0"
  },
  "packageManager": "pnpm@11.17.0"
}
